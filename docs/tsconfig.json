{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./src/dist",
    "rootDir": "./src/ts"
  },
  "include": ["src/ts/**/*"],
  "exclude": ["node_modules", "src/dist", "src/tests"]
}
