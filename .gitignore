# ==========================================
# Bangplanix .gitignore
# ==========================================

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.user
*.userosscache
*.sln.docstates

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.userprefs

# JetBrains Rider
.idea/
*.DotSettings.user

# Node / Lit Frontend
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage

# Secrets, Environment & Cryptographic Keys
.env
.env.*
*.env
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.secret
*.credentials

# Test / Coverage Results
TestResults/
coverage/
*.cobertura.xml

# Local Databases & SQLite
*.db
*.sqlite
*.sqlite3

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Output Exports (Temporary artifacts generated by tests or CLI)
output/
temp/
*.tmp
