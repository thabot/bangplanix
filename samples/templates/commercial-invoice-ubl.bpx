{
  "$schema": "https://bangplanix.io/schemas/v1/bangplanix.schema.json",
  "version": "1.0.0",
  "metadata": {
    "title": "International Commercial Invoice",
    "standard": "UN/CEFACT & UBL 2.1",
    "author": "Bangplanix Global Trade"
  },
  "pageSetup": {
    "paperKind": "A4",
    "orientation": "Portrait",
    "margins": { "top": 25, "bottom": 25, "left": 25, "right": 25 }
  },
  "parameters": [
    { "name": "Exporter", "type": "string", "defaultValue": "BANGPLANIX TECHNOLOGIES PTE. LTD." },
    { "name": "Consignee", "type": "string", "defaultValue": "NORDIC CLOUD INFRASTRUCTURE AB" },
    { "name": "InvoiceNo", "type": "string", "defaultValue": "EXP-2026-SE091" },
    { "name": "Incoterms", "type": "string", "defaultValue": "DDP Stockholm (Incoterms 2020)" },
    { "name": "Currency", "type": "string", "defaultValue": "EUR" }
  ],
  "datasets": [
    { "name": "items", "source": "json" }
  ],
  "bands": {
    "title": {
      "height": 90,
      "elements": [
        { "type": "text", "bounds": { "x": 0, "y": 0, "width": 320, "height": 22 }, "expression": "=Parameters!Exporter.Value", "fontSize": 13, "fontWeight": "Bold" },
        { "type": "text", "bounds": { "x": 0, "y": 22, "width": 320, "height": 16 }, "content": "10 Marina Boulevard, Tower 2, Singapore 018983", "fontSize": 8.5, "textColor": "#64748b" },
        { "type": "text", "bounds": { "x": 330, "y": 0, "width": 215, "height": 24 }, "content": "COMMERCIAL INVOICE", "fontSize": 15, "fontWeight": "Bold", "textAlign": "Right", "textColor": "#0f172a" },
        { "type": "text", "bounds": { "x": 330, "y": 24, "width": 215, "height": 16 }, "expression": "=\"Invoice No: \" + Parameters!InvoiceNo.Value", "fontSize": 9.5, "fontWeight": "Bold", "textAlign": "Right" },
        { "type": "text", "bounds": { "x": 330, "y": 40, "width": 215, "height": 16 }, "expression": "=\"Terms: \" + Parameters!Incoterms.Value", "fontSize": 8.5, "textAlign": "Right", "textColor": "#475569" },
        { "type": "line", "bounds": { "x": 0, "y": 80, "width": 545, "height": 1 }, "strokeColor": "#0f172a", "strokeWidth": 1.5 }
      ]
    },
    "pageHeader": {
      "height": 26,
      "elements": [
        { "type": "rectangle", "bounds": { "x": 0, "y": 0, "width": 545, "height": 22 }, "fillColor": "#0f172a" },
        { "type": "text", "bounds": { "x": 10, "y": 4, "width": 250, "height": 14 }, "content": "Description of Goods & Services", "fontSize": 9, "fontWeight": "Bold", "textColor": "#ffffff" },
        { "type": "text", "bounds": { "x": 270, "y": 4, "width": 50, "height": 14 }, "content": "Qty", "fontSize": 9, "fontWeight": "Bold", "textAlign": "Right", "textColor": "#ffffff" },
        { "type": "text", "bounds": { "x": 330, "y": 4, "width": 95, "height": 14 }, "content": "Unit Price (EUR)", "fontSize": 9, "fontWeight": "Bold", "textAlign": "Right", "textColor": "#ffffff" },
        { "type": "text", "bounds": { "x": 435, "y": 4, "width": 100, "height": 14 }, "content": "Amount (EUR)", "fontSize": 9, "fontWeight": "Bold", "textAlign": "Right", "textColor": "#ffffff" }
      ]
    },
    "detail": {
      "dataset": "items",
      "height": 22,
      "elements": [
        { "type": "text", "bounds": { "x": 10, "y": 3, "width": 250, "height": 14 }, "expression": "=Fields!name.Value", "fontSize": 9 },
        { "type": "text", "bounds": { "x": 270, "y": 3, "width": 50, "height": 14 }, "expression": "=Fields!qty.Value", "fontSize": 9, "textAlign": "Right" },
        { "type": "text", "bounds": { "x": 330, "y": 3, "width": 95, "height": 14 }, "expression": "=Fields!unitPrice.Value", "fontSize": 9, "textAlign": "Right", "format": "N2" },
        { "type": "text", "bounds": { "x": 435, "y": 3, "width": 100, "height": 14 }, "expression": "=Fields!amount.Value", "fontSize": 9, "textAlign": "Right", "fontWeight": "Bold", "format": "N2" },
        { "type": "line", "bounds": { "x": 0, "y": 20, "width": 545, "height": 1 }, "strokeColor": "#e2e8f0", "strokeWidth": 1 }
      ]
    },
    "pageFooter": {
      "height": 60,
      "elements": [
        { "type": "line", "bounds": { "x": 0, "y": 4, "width": 545, "height": 1 }, "strokeColor": "#0f172a", "strokeWidth": 1.5 },
        { "type": "text", "bounds": { "x": 300, "y": 10, "width": 120, "height": 16 }, "content": "TOTAL PAYABLE (EUR):", "fontSize": 10, "fontWeight": "Bold", "textAlign": "Right" },
        { "type": "text", "bounds": { "x": 430, "y": 10, "width": 105, "height": 16 }, "content": "45,000.00 €", "fontSize": 11, "fontWeight": "Bold", "textAlign": "Right", "textColor": "#1e3a8a" },
        { "type": "barcode", "bounds": { "x": 0, "y": 10, "width": 180, "height": 26 }, "expression": "=Parameters!InvoiceNo.Value", "symbology": "Code128" }
      ]
    }
  }
}
