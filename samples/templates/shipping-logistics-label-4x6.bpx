{
  "$schema": "https://bangplanix.io/schemas/v1/bangplanix.schema.json",
  "version": "1.0.0",
  "metadata": {
    "title": "Logistics & Shipping Label 4x6",
    "standard": "GS1 / Zebra ZPL II",
    "author": "Bangplanix Logistics"
  },
  "pageSetup": {
    "paperKind": "Custom",
    "width": 101.6,
    "height": 152.4,
    "orientation": "Portrait",
    "margins": { "top": 5, "bottom": 5, "left": 5, "right": 5 }
  },
  "parameters": [
    { "name": "TrackingNo", "type": "string", "defaultValue": "BPX-TH-882910482" },
    { "name": "Courier", "type": "string", "defaultValue": "EXPRESS NEXT-DAY" },
    { "name": "SenderName", "type": "string", "defaultValue": "Warehouse Distribution Hub 4" },
    { "name": "RecipientName", "type": "string", "defaultValue": "Somchai Tech Solutions Co., Ltd." }
  ],
  "bands": {
    "title": {
      "height": 140,
      "elements": [
        { "type": "rectangle", "bounds": { "x": 0, "y": 0, "width": 91.6, "height": 22 }, "fillColor": "#0f172a" },
        { "type": "text", "bounds": { "x": 4, "y": 4, "width": 50, "height": 14 }, "expression": "=Parameters!Courier.Value", "fontSize": 10, "fontWeight": "Bold", "textColor": "#ffffff" },
        { "type": "text", "bounds": { "x": 55, "y": 4, "width": 32, "height": 14 }, "content": "ZONE: BKK-01", "fontSize": 9, "fontWeight": "Bold", "textAlign": "Right", "textColor": "#38bdf8" },
        { "type": "text", "bounds": { "x": 2, "y": 26, "width": 88, "height": 12 }, "content": "SHIP FROM:", "fontSize": 7, "fontWeight": "Bold", "textColor": "#64748b" },
        { "type": "text", "bounds": { "x": 2, "y": 38, "width": 88, "height": 12 }, "expression": "=Parameters!SenderName.Value", "fontSize": 8 },
        { "type": "line", "bounds": { "x": 0, "y": 52, "width": 91.6, "height": 1 }, "strokeColor": "#000000", "strokeWidth": 1 },
        { "type": "text", "bounds": { "x": 2, "y": 56, "width": 88, "height": 12 }, "content": "SHIP TO:", "fontSize": 8, "fontWeight": "Bold" },
        { "type": "text", "bounds": { "x": 2, "y": 68, "width": 88, "height": 14 }, "expression": "=Parameters!RecipientName.Value", "fontSize": 9, "fontWeight": "Bold" },
        { "type": "text", "bounds": { "x": 2, "y": 82, "width": 88, "height": 12 }, "content": "88/12 Sukhumvit 71 Road, Phra Khanong, Bangkok 10110", "fontSize": 7.5 },
        { "type": "line", "bounds": { "x": 0, "y": 96, "width": 91.6, "height": 1 }, "strokeColor": "#000000", "strokeWidth": 1.5 },
        { "type": "barcode", "bounds": { "x": 10, "y": 100, "width": 71.6, "height": 26 }, "expression": "=Parameters!TrackingNo.Value", "symbology": "Code128" },
        { "type": "text", "bounds": { "x": 0, "y": 128, "width": 91.6, "height": 10 }, "expression": "=Parameters!TrackingNo.Value", "fontSize": 8, "textAlign": "Center", "fontWeight": "Bold" }
      ]
    }
  }
}
